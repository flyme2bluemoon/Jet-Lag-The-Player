{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:seekers-routes": "node scripts/check-seekers-rail-routes.mjs",
    "check:unused-exports": "node scripts/check-unused-exports.mjs",
    "generate:geojson": "node scripts/generate-geojson-assets.mjs",
    "watch:geojson": "node scripts/watch-geojson-assets.mjs",
    "dev": "pnpm generate:geojson && concurrently --kill-others --names geojson,next \"pnpm watch:geojson\" \"next dev\"",
    "build": "pnpm generate:geojson && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@turf/bearing": "^7.3.5",
    "@turf/great-circle": "^7.3.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.10",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
